<clickhouse>
    <profiles>
        <grafana>
            <readonly>1</readonly>
            <max_threads>8</max_threads>
            <max_execution_time>120</max_execution_time>
            <max_memory_usage>17179869184</max_memory_usage>
            <max_concurrent_queries_for_user>12</max_concurrent_queries_for_user>
            <constraints>
                <!-- Grafana's ClickHouse plugin applies this setting to each
                     query. Permit only this bounded setting to change while
                     keeping the user fully read-only for data operations. -->
                <max_execution_time>
                    <min>1</min>
                    <max>120</max>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </grafana>
    </profiles>
    <users>
        <grafana>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>
            <profile>grafana</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
        </grafana>
    </users>
</clickhouse>
