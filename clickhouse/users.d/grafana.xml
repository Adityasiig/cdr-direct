<clickhouse>
    <profiles>
        <grafana>
            <readonly>1</readonly>
            <max_threads>8</max_threads>
            <max_execution_time>120</max_execution_time>
            <!-- Per-query cap: 32 GiB. The SIP-Reason-by-Customer panel at
                 per-code (billed_prefix) grain over a 7d window aggregates
                 ~32.7M distinct groups, peaking ~17.4 GiB off the hourly
                 rollup. 16 GiB was too low and OOM'd (code 241). -->
            <max_memory_usage>34359738368</max_memory_usage>
            <!-- Box guard: cap TOTAL memory across all of this user's
                 concurrent queries at 96 GiB so a burst of heavy panel loads
                 can never starve live ingest on the 251 GiB host. -->
            <max_memory_usage_for_user>103079215104</max_memory_usage_for_user>
            <!-- Spill GROUP BY to disk past 8 GiB. Loop Detection groups
                 ~70M rows by (ANI, DNIS) over a 24h window, which peaks
                 ~20 GiB fully in RAM; spilling holds it near 9 GiB. Set on
                 the profile because a readonly user cannot change it
                 per-query (code 164). -->
            <max_bytes_before_external_group_by>8589934592</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>8589934592</max_bytes_before_external_sort>
            <max_concurrent_queries_for_user>12</max_concurrent_queries_for_user>
            <constraints>
                <!-- Grafana's ClickHouse plugin applies this setting to each
                     query. Permit only this setting to change while
                     keeping the user fully read-only for data operations. -->
                <max_execution_time>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </grafana>
    </profiles>
    <users>
        <grafana>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>
            <profile>grafana</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
        </grafana>
    </users>
</clickhouse>
