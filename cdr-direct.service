[Unit]
Description=CDR Direct - DuckDB query API over 46labs CSV files
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cdr-direct
EnvironmentFile=-/etc/cdr-direct.env
ExecStart=/usr/local/bin/gunicorn -w 2 -b 127.0.0.1:8090 --timeout 360 --access-logfile /var/log/cdr-direct-access.log --error-logfile /var/log/cdr-direct-error.log api:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
