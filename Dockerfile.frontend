FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CDR_PROXY_TIMEOUT=1800

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 cdrproxy

COPY frontend_proxy.py ./
COPY static ./static
COPY templates ./templates

USER cdrproxy
EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/ready', timeout=3)" || exit 1

CMD ["sh", "-c", "exec gunicorn --workers 2 --threads 4 --bind 0.0.0.0:8090 --timeout ${CDR_WEB_TIMEOUT:-1830} --access-logfile - --error-logfile - frontend_proxy:app"]
