# Raw-CDR server only. Copy to .env beside docker-compose.data-node.yml.
# Point this DNS hostname at the raw server's public IP (DNS-only, no CDN).
CDR_API_DOMAIN=cdr-api.example.com
# Only this public IP/CIDR may pass through the HTTPS gateway.
COOLIFY_PUBLIC_IP=203.0.113.10/32
CDR_BACKEND_TOKEN=replace-with-a-long-random-private-token

# Local paths on the raw-CDR server.
CDR_RAW_HOST_PATH=/srv/46labs/cdr
CDR_RUNTIME_HOST_PATH=/var/lib/cdr-direct/runtime
CDR_PARQUET_HOST_PATH=/var/lib/cdr-direct/parquet

# Starting profile for the 256 GB analytics server.
CDR_DUCKDB_THREADS=16
CDR_DUCKDB_MEMORY_LIMIT=64GB
CDR_WEB_THREADS=2
