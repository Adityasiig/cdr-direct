{
  "annotations": {
    "list": []
  },
  "description": "Per-call CDR detail: start time, ANI/DNIS, customer trunk, SIP code, release reason, billed prefix, state and rate center. Includes SIP reason percentage breakdown.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cdr-clickhouse"
      },
      "description": "Per customer trunk AND termination state: SIP reason breakdown with the raw billed-prefix Codes (e.g. 1304522) shown per code. '% of Cust+State' = share of that customer+state's attempts. Customers with no traffic in a state appear as a single 0% '(no traffic)' row so coverage gaps are visible. Heavy unfiltered (per-code grain, 24h ~14M rows); select a Customer Trunk to make it fast. Respects CDR Source and Customer Trunk filters; ignores SIP Code filter.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% of Cust+State"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempts"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Attempts",
            "desc": true
          }
        ]
      },
      "pluginVersion": "12.4.0",
      "targets": [
        {
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "WITH custs AS (SELECT DISTINCT orig_trunk_group_name AS cust FROM cdr.sip_reason_cust_state_hourly WHERE $__timeFilter(hour) AND day >= toDate($__fromTime) AND orig_trunk_group_name != '(none)' AND $__conditionalAll(entity = ${entity:singlequote}, $entity) AND $__conditionalAll(orig_trunk_group_name = ${origin_trunk:singlequote}, $origin_trunk)), sts AS (SELECT DISTINCT term_state AS st FROM cdr.sip_reason_cust_state_hourly WHERE $__timeFilter(hour) AND day >= toDate($__fromTime) AND notEmpty(term_state) AND $__conditionalAll(entity = ${entity:singlequote}, $entity)), actual AS (SELECT orig_trunk_group_name AS cust, term_state AS st, if(notEmpty(billed_prefix), billed_prefix, '—') AS code, concat(toString(sip_code),' - ',reason) AS rsn, sum(attempts) AS att FROM cdr.sip_reason_cust_state_hourly WHERE $__timeFilter(hour) AND day >= toDate($__fromTime) AND notEmpty(term_state) AND $__conditionalAll(entity = ${entity:singlequote}, $entity) AND $__conditionalAll(orig_trunk_group_name = ${origin_trunk:singlequote}, $origin_trunk) GROUP BY cust, st, code, rsn), tot AS (SELECT cust, st, sum(att) AS t FROM actual GROUP BY cust, st) SELECT g.cust AS `Customer Trunk`, g.st AS `State`, if(a.att=0,'—',a.code) AS `Codes`, if(a.att=0,'(no traffic)',a.rsn) AS `SIP Reason`, a.att AS `Attempts`, if(tot.t=0, 0, round(100.0*a.att/tot.t,2)) AS `% of Cust+State` FROM (SELECT cust, st FROM custs CROSS JOIN sts) g LEFT JOIN actual a ON g.cust=a.cust AND g.st=a.st LEFT JOIN tot ON g.cust=tot.cust AND g.st=tot.st ORDER BY `Attempts` DESC LIMIT 5000",
          "refId": "A"
        }
      ],
      "title": "SIP Reason by Customer & State",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cdr-clickhouse"
      },
      "description": "One row per CDR leg in the selected time range. Filter by CDR source, customer trunk and SIP code above.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "12.4.0",
      "targets": [
        {
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT call_start_time AS `Start Time`, from_did AS `ANI`, to_did AS `DNIS`, orig_trunk_group_name AS `Customer Trunk`, sip_code AS `SIP Code`, coalesce(nullIf(reason, ''), nullIf(sip_reason, ''), 'Not provided') AS `Release Reason`, if(billed_prefix = '', '?', billed_prefix) AS `Billed Prefix`, term_state AS `State`, term_ratecenter AS `Rate Center`, entity AS `CDR Source`, callid AS `Call ID` FROM cdr.raw_cdr WHERE $__timeFilter(event_time) AND $__conditionalAll(entity = ${entity:singlequote}, $entity) AND $__conditionalAll(orig_trunk_group_name = ${origin_trunk:singlequote}, $origin_trunk) AND $__conditionalAll(toString(sip_code) = ${sip_code:singlequote}, $sip_code) ORDER BY event_time DESC LIMIT 10000",
          "refId": "A"
        }
      ],
      "title": "CDR Detail (latest 10,000)",
      "type": "table"
    },
    {
      "id": 20,
      "type": "volkovlabs-table-panel",
      "pluginVersion": "3.6.8",
      "title": "Rural Code Traffic (latest ${rural_row_limit})",
      "description": "Calls whose billed prefix (NPA-NXX) appears in the rural prefix list (cdr.rural_prefix_list). Follows the dashboard time range and the CDR source / customer trunk / SIP code filters above. Use the toolbar to export as Excel (.xlsx) or CSV.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cdr-clickhouse"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 73
      },
      "maxDataPoints": 500000,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cdr-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.15.0",
          "rawSql": "SELECT call_start_time AS `Start Time`, from_did AS `ANI`, to_did AS `DNIS`, billed_prefix AS `Rural Code`, orig_trunk_group_name AS `Customer Trunk`, orig_carrier_name AS `Customer Carrier`, term_carrier_name AS `Termination Vendor`, term_trunk_group_name AS `Termination Trunk`, entity AS `CDR Source`, sip_code AS `SIP Code`, if(sip_code = 200, 'Answered', 'Failed') AS `Result`, coalesce(nullIf(reason, ''), nullIf(sip_reason, ''), 'Not provided') AS `Release Reason`, duration_real AS `Duration Sec`, term_state AS `State`, term_ratecenter AS `Rate Center`, callid AS `Call ID` FROM cdr.raw_cdr WHERE $__timeFilter(event_time) AND billed_prefix IN (SELECT billed_prefix FROM cdr.rural_prefix_list) AND $__conditionalAll(entity = ${entity:singlequote}, $entity) AND $__conditionalAll(orig_trunk_group_name = ${origin_trunk:singlequote}, $origin_trunk) AND $__conditionalAll(toString(sip_code) = ${sip_code:singlequote}, $sip_code) AND record_key IN (SELECT record_key FROM cdr.raw_cdr WHERE $__timeFilter(event_time) AND billed_prefix IN (SELECT billed_prefix FROM cdr.rural_prefix_list) AND $__conditionalAll(entity = ${entity:singlequote}, $entity) AND $__conditionalAll(orig_trunk_group_name = ${origin_trunk:singlequote}, $origin_trunk) AND $__conditionalAll(toString(sip_code) = ${sip_code:singlequote}, $sip_code) ORDER BY event_time DESC LIMIT ${rural_row_limit}) ORDER BY event_time DESC",
          "meta": {
            "builderOptions": {
              "columns": [],
              "database": "cdr",
              "limit": 0,
              "mode": "list",
              "queryType": "table",
              "table": "raw_cdr"
            }
          }
        }
      ],
