FROM clickhouse/clickhouse-server:26.3

RUN mkdir -p /cdr-source/cdr \
    && chown -R clickhouse:clickhouse /cdr-source

COPY clickhouse/config.d/ /etc/clickhouse-server/config.d/
COPY clickhouse/init/ /docker-entrypoint-initdb.d/
COPY clickhouse/users.d/ /etc/clickhouse-server/users.d/

# IP -> ISP lookup source (ip2asn snapshot, "CIDR<TAB>ISP"). Read by the
# ip_trie dictionary cdr.ip_isp (see clickhouse/init/002_ip_isp_dict.sql).
# Placed under user_files_path (/cdr-source/) so the FILE() dictionary source
# is permitted to read it.
COPY clickhouse/data/ip_isp_cidr.tsv.gz /cdr-source/ip_isp_cidr.tsv.gz
RUN gunzip -f /cdr-source/ip_isp_cidr.tsv.gz \
    && chown clickhouse:clickhouse /cdr-source/ip_isp_cidr.tsv

# IP -> ISP name and IP -> location sources (DB-IP Lite, "CIDR<TAB>value").
# Read by the ip_trie dictionaries cdr.ip_isp_name and cdr.ip_location (see
# clickhouse/init/005_ip_isp_location_dicts.sql). These carry registered org
# names and geo-location, unlike the raw AS handles in ip_isp_cidr.tsv.
COPY clickhouse/data/ip_isp_trie.tsv.gz /cdr-source/ip_isp_trie.tsv.gz
COPY clickhouse/data/ip_loc_trie.tsv.gz /cdr-source/ip_loc_trie.tsv.gz
RUN gunzip -f /cdr-source/ip_isp_trie.tsv.gz /cdr-source/ip_loc_trie.tsv.gz \
    && chown clickhouse:clickhouse /cdr-source/ip_isp_trie.tsv /cdr-source/ip_loc_trie.tsv

# Rural NPA-NXX billed prefixes, loaded into cdr.rural_prefix_list by
# clickhouse/init/003_rural_prefixes.sql. Under user_files_path so file() can
# read it during init.
COPY clickhouse/data/rural_prefixes.csv /cdr-source/rural_prefixes.csv
RUN chown clickhouse:clickhouse /cdr-source/rural_prefixes.csv
